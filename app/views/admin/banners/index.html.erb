<% content_for :title, "Banners" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-xl font-bold text-gray-800">Hero Banners</h2>
    <p class="text-sm text-gray-500 mt-1">Manage banners displayed on the home page hero carousel.</p>
  </div>
  <%= link_to new_admin_banner_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md shadow-sm hover:bg-indigo-700 transition-colors" do %>
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    New Banner
  <% end %>
</div>

<% if @banners.empty? %>
  <div class="bg-white rounded-lg shadow p-16 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <p class="text-gray-500 font-medium">No banners yet.</p>
    <p class="text-sm text-gray-400 mt-1">Create your first banner to display it on the home page.</p>
    <%= link_to "Add Banner", new_admin_banner_path, class: "mt-4 inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700" %>
  </div>
<% else %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Banner</th>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Details</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Position</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @banners.each do |banner| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <!-- Thumbnail -->
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="h-16 w-28 rounded-md overflow-hidden bg-gray-100 border border-gray-200">
                <% if banner.image.attached? %>
                  <img src="<%= url_for(banner.image) %>" alt="<%= banner.title %>" class="h-full w-full object-cover" />
                <% elsif banner.image_url.present? && banner.image_url != 'local_upload' %>
                  <img src="<%= banner.image_url %>" alt="<%= banner.title %>" class="h-full w-full object-cover" onerror="this.style.display='none'" />
                <% else %>
                  <div class="h-full w-full flex items-center justify-center">
                    <svg class="w-6 h-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                <% end %>
              </div>
            </td>

            <!-- Details -->
            <td class="px-6 py-4">
              <div class="flex flex-col">
                <span class="text-sm font-semibold text-gray-900"><%= banner.title %></span>
                <% if banner.subtitle.present? %>
                  <span class="text-xs text-gray-500 mt-0.5"><%= banner.subtitle %></span>
                <% end %>
                <% if banner.badge_text.present? %>
                  <span class="inline-flex mt-1 w-fit items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700">
                    <%= banner.badge_text %>
                  </span>
                <% end %>
                <span class="text-xs text-gray-400 mt-1">Align: <%= banner.text_align %></span>
              </div>
            </td>

            <!-- Position -->
            <td class="px-6 py-4 whitespace-nowrap text-center">
              <span class="inline-flex items-center justify-center h-7 w-7 rounded-full bg-gray-100 text-sm font-bold text-gray-700">
                <%= banner.position %>
              </span>
            </td>

            <!-- Status toggle -->
            <td class="px-6 py-4 whitespace-nowrap text-center">
              <%= form_with model: [:admin, banner], method: :patch, class: "inline" do |f| %>
                <%= f.hidden_field :active, value: !banner.active %>
                <%= f.button type: "submit",
                    class: "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium transition-colors #{banner.active ? 'bg-green-100 text-green-700 hover:bg-green-200' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'}" do %>
                  <span class="w-2 h-2 rounded-full mr-1.5 inline-block <%= banner.active ? 'bg-green-500' : 'bg-gray-400' %>"></span>
                  <%= banner.active? ? "Active" : "Inactive" %>
                <% end %>
              <% end %>
            </td>

            <!-- Actions -->
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
              <%= link_to edit_admin_banner_path(banner), class: "inline-flex items-center text-indigo-600 hover:text-indigo-900 font-medium" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Edit
              <% end %>
              <%= link_to admin_banner_path(banner),
                  data: { turbo_method: :delete, turbo_confirm: "Delete \"#{banner.title}\"? This cannot be undone." },
                  class: "inline-flex items-center text-red-600 hover:text-red-800 font-medium" do %>
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                Delete
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
