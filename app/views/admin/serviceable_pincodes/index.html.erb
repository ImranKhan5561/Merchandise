<% content_for :title, "Delivery Zones" %>

<div class="mb-6 flex items-center justify-between">
  <div>
    <h2 class="text-xl font-bold text-gray-800">Manage Serviceable Pincodes</h2>
    <p class="text-sm text-gray-500 mt-1">Add or remove postal codes where shipping is available.</p>
  </div>
  <%= link_to new_admin_serviceable_pincode_path, class: "inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md shadow-sm hover:bg-indigo-700 transition-colors" do %>
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
    </svg>
    Add Pincode
  <% end %>
</div>

<div class="mb-6 bg-white p-4 shadow rounded-lg flex items-center justify-between">
  <%= form_with url: admin_serviceable_pincodes_path, method: :get, class: "flex w-full max-w-sm items-center space-x-2" do |f| %>
    <%= f.text_field :query, value: params[:query], placeholder: "Search pincodes...", class: "block w-full rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
    <%= f.submit "Search", name: nil, class: "px-4 py-2 bg-gray-100 text-gray-700 font-medium rounded-md hover:bg-gray-200 border border-transparent cursor-pointer" %>
  <% end %>
</div>

<% if @pincodes.empty? %>
  <div class="bg-white rounded-lg shadow p-16 text-center">
    <svg class="mx-auto h-12 w-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.242-4.243a8 8 0 1111.314 0z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
    </svg>
    <p class="text-gray-500 font-medium">No pincodes found.</p>
    <%= link_to "Add a new pincode", new_admin_serviceable_pincode_path, class: "mt-4 inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700" %>
  </div>
<% else %>
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Pincode</th>
          <th class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @pincodes.each do |pincode| %>
          <tr class="hover:bg-gray-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
              <%= pincode.code %>
            </td>

            <td class="px-6 py-4 whitespace-nowrap text-center">
              <%= form_with model: [:admin, pincode], method: :patch, class: "inline" do |f| %>
                <%= f.hidden_field :active, value: !pincode.active %>
                <%= f.button type: "submit", class: "inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium transition-colors cursor-pointer #{pincode.active ? 'bg-green-100 text-green-700 hover:bg-green-200' : 'bg-gray-100 text-gray-500 hover:bg-gray-200'}" do %>
                  <span class="w-2 h-2 rounded-full mr-1.5 inline-block <%= pincode.active ? 'bg-green-500' : 'bg-gray-400' %>"></span>
                  <%= pincode.active? ? "Active" : "Inactive" %>
                <% end %>
              <% end %>
            </td>

            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
              <%= link_to edit_admin_serviceable_pincode_path(pincode), class: "inline-flex items-center text-indigo-600 hover:text-indigo-900 font-medium" do %>
                Edit
              <% end %>
              <%= link_to admin_serviceable_pincode_path(pincode),
                  data: { turbo_method: :delete, turbo_confirm: "Delete this pincode?" },
                  class: "inline-flex items-center text-red-600 hover:text-red-800 font-medium" do %>
                Delete
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
